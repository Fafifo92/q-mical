---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Wave from "../components/Wave.astro";
import ProductCard from "../components/ProductCard.astro";
import CtaBand from "../components/CtaBand.astro";
import { waLink } from "../data/site";
import { SECTORES_INFO } from "../data/taxonomy";
import type { SectorCopy } from "../data/sectores";
import { getCatalogo } from "../lib/catalog";
import { DEFAULT_LOCALE, rutaLocal, tpl, type Locale } from "../i18n/config";
import { t, taxonomia, sectoresCopy } from "../i18n";

interface Props {
  copy: SectorCopy;
  lang?: Locale;
}
const { copy, lang = DEFAULT_LOCALE } = Astro.props;
const dict = t(lang);
const tax = taxonomia(lang);
const cat = getCatalogo(lang);

const nombre = tax.sector(copy.slug);
const info = SECTORES_INFO[copy.slug] ?? { color: "#157a64", icono: "flask" };
const productos = cat.porSector(copy.slug);

// Destacados primero, luego alfabético
const muestra = [...productos]
  .sort((a, b) => Number(b.destacado) - Number(a.destacado) || a.nombre.localeCompare(b.nombre, lang))
  .slice(0, 8);

// Conteo por especialidad clave
const familias = copy.especialidadesClave
  .map((esp) => ({ esp, label: tax.especialidad(esp), n: productos.filter((p) => p.especialidades.includes(esp)).length }))
  .filter((f) => f.n > 0);

// Otros segmentos: los 3 más grandes distintos de este
const otros = sectoresCopy(lang)
  .map((s) => s.slug)
  .filter((s) => s !== copy.slug)
  .map((s) => ({ slug: s, n: cat.porSector(s).length }))
  .sort((a, b) => b.n - a.n)
  .slice(0, 3);

const sectorMinuscula = nombre.toLocaleLowerCase(lang);
---

<Base title={`${nombre} — ${dict.segmentos.tituloMeta}`} description={copy.intro[0]} headerTheme="dark" og="sectores" lang={lang}>
  <!-- ═══ Héroe del sector ═══ -->
  <section class="hero-mesh" style={`--mesh-color:${info.color}`}>
    <div class="container-site grid items-center gap-12 pt-28 pb-16 md:pt-36 lg:grid-cols-[1.25fr_1fr]">
      <div class="min-w-0">
        <nav class="reveal flex flex-wrap items-center gap-2 text-xs text-ink-300" aria-label="Breadcrumb">
          <a href={rutaLocal(lang, "/")} class="hover:text-accent-300">{dict.segmento.migaInicio}</a>
          <span aria-hidden="true">/</span>
          <a href={rutaLocal(lang, "/sectores")} class="hover:text-accent-300">{dict.segmento.migaSectores}</a>
          <span aria-hidden="true">/</span>
          <span class="font-medium text-white">{nombre}</span>
        </nav>

        <p class="reveal eyebrow mt-6 text-accent-300" style="--reveal-delay:.08s">
          {tpl(dict.segmento.eyebrow, { sector: nombre })}
        </p>
        <h1 class="reveal mt-3 font-display text-4xl leading-[1.08] font-bold text-white sm:text-5xl" style="--reveal-delay:.16s">
          {copy.titulo}
        </h1>
        <p class="reveal mt-5 max-w-xl text-base leading-relaxed text-ink-200 sm:text-lg" style="--reveal-delay:.24s">
          {copy.intro[0]}
        </p>
        <div class="reveal mt-7 flex flex-wrap gap-3" style="--reveal-delay:.32s">
          <a href={rutaLocal(lang, `/productos?sector=${copy.slug}`)} class="btn-accent min-h-12 px-6 text-sm">
            {tpl(dict.segmento.botonVerProductos, { n: productos.length })}
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
          <a href={waLink(copy.mensajeWhatsApp)} target="_blank" rel="noopener" class="btn-whatsapp min-h-12 px-6 text-sm">
            <Icon name="whatsapp" class="h-5 w-5" />
            {dict.segmento.botonAsesor}
          </a>
        </div>
      </div>

      <!-- Panel visual -->
      <div class="reveal hidden lg:block" style="--reveal-delay:.3s">
        <div class="relative rounded-3xl border border-white/10 bg-white/5 p-8 backdrop-blur">
          <span
            class="grid h-20 w-20 place-items-center rounded-2xl"
            style={`background:color-mix(in srgb, ${info.color} 30%, transparent); color:${info.color}`}
          >
            <Icon name={info.icono} class="h-10 w-10" />
          </span>
          <dl class="mt-8 grid grid-cols-2 gap-6">
            <div>
              <dd class="font-display text-4xl font-bold text-white">{productos.length}</dd>
              <dt class="mt-1 text-xs text-ink-300">{dict.segmento.statSector}</dt>
            </div>
            <div>
              <dd class="font-display text-4xl font-bold text-white">{familias.length}</dd>
              <dt class="mt-1 text-xs text-ink-300">{dict.segmento.statFamilias}</dt>
            </div>
            <div class="col-span-2 border-t border-white/10 pt-5">
              <p class="flex items-center gap-2 text-sm text-ink-200">
                <Icon name="file-text" class="h-4 w-4 shrink-0 text-accent-300" />
                {dict.segmento.panelDocs}
              </p>
              <p class="mt-2 flex items-center gap-2 text-sm text-ink-200">
                <Icon name="beaker" class="h-4 w-4 shrink-0 text-accent-300" />
                {dict.segmento.panelMuestras}
              </p>
            </div>
          </dl>
        </div>
      </div>
    </div>
    <Wave />
  </section>

  <!-- ═══ Cómo apoyamos ═══ -->
  <section class="container-site py-16 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:items-start">
      <div class="reveal lg:sticky lg:top-28">
        <p class="eyebrow">{dict.segmento.apoyoEyebrow}</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight">{dict.segmento.apoyoTitulo}</h2>
        <p class="mt-4 leading-relaxed text-ink-500">{copy.intro[1]}</p>
      </div>
      <div class="grid gap-5">
        {
          copy.retos.map((r, i) => (
            <article class="card reveal flex gap-5 p-7" style={`--reveal-delay:${i * 0.1}s`}>
              <span
                class="grid h-11 w-11 shrink-0 place-items-center rounded-xl font-display text-sm font-bold"
                style={`background:color-mix(in srgb, ${info.color} 12%, white); color:color-mix(in srgb, ${info.color} 60%, black)`}
              >
                {String(i + 1).padStart(2, "0")}
              </span>
              <div class="min-w-0">
                <h3 class="font-display text-lg font-bold">{r.titulo}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-500">{r.texto}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══ Familias clave ═══ -->
  {
    familias.length > 0 && (
      <section class="border-y border-ink-100 bg-white py-16 sm:py-20">
        <div class="container-site">
          <div class="reveal max-w-2xl">
            <p class="eyebrow">{dict.segmento.familiasEyebrow}</p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight">{dict.segmento.familiasTitulo}</h2>
            <p class="mt-4 text-ink-500">{tpl(dict.segmento.familiasTexto, { sector: sectorMinuscula })}</p>
          </div>
          <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {familias.map((f, i) => (
              <a
                href={rutaLocal(lang, `/productos?sector=${copy.slug}&esp=${f.esp}`)}
                class="card card-linea reveal group flex items-center gap-4 p-5"
                style={`--linea-color:${info.color};--reveal-delay:${(i % 3) * 0.08}s`}
              >
                <span
                  class="grid h-11 w-11 shrink-0 place-items-center rounded-xl transition-transform duration-300 group-hover:scale-110"
                  style={`background:color-mix(in srgb, ${info.color} 12%, white); color:${info.color}`}
                >
                  <Icon name="filter" class="h-5 w-5" />
                </span>
                <div class="min-w-0 flex-1">
                  <h3 class="font-display text-sm font-bold text-ink-950 group-hover:text-brand-700">{f.label}</h3>
                  <p class="text-xs text-ink-500">
                    {f.n === 1 ? dict.segmento.familiaConteoUno : tpl(dict.segmento.familiaConteo, { n: f.n })}
                  </p>
                </div>
                <Icon name="arrow-right" class="h-4 w-4 shrink-0 text-ink-300 transition-transform duration-300 group-hover:translate-x-1" />
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ═══ Productos del sector ═══ -->
  <section class="container-site py-16 sm:py-20">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="reveal max-w-xl">
        <p class="eyebrow">{dict.segmento.seleccionEyebrow}</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight">
          {tpl(dict.segmento.seleccionTitulo, { sector: sectorMinuscula })}
        </h2>
      </div>
      <a href={rutaLocal(lang, `/productos?sector=${copy.slug}`)} class="btn-ghost reveal min-h-11 px-6 text-sm">
        {tpl(dict.segmento.botonVerProductos, { n: productos.length })}
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {muestra.map((p, i) => <ProductCard producto={p} reveal revealDelay={(i % 4) * 0.08} lang={lang} />)}
    </div>
  </section>

  <!-- ═══ Nota regulatoria ═══ -->
  {
    copy.regulatorio && (
      <section class="container-site pb-16">
        <aside class="card reveal mx-auto flex max-w-3xl gap-4 p-6" role="note">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-700">
            <Icon name="clipboard-check" class="h-5 w-5" />
          </span>
          <div class="min-w-0">
            <h2 class="font-display text-base font-bold">{dict.segmento.regulatorio}</h2>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-500">{copy.regulatorio}</p>
          </div>
        </aside>
      </section>
    )
  }

  <!-- ═══ Otros segmentos ═══ -->
  <section class="border-t border-ink-100 bg-white py-16">
    <div class="container-site">
      <h2 class="reveal font-display text-2xl font-bold">{dict.segmento.otros}</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-3">
        {
          otros.map(({ slug, n }, i) => {
            const oInfo = SECTORES_INFO[slug]!;
            return (
              <a
                href={rutaLocal(lang, `/sectores/${slug}`)}
                class="card card-linea reveal group flex items-center gap-4 p-6"
                style={`--linea-color:${oInfo.color};--reveal-delay:${i * 0.08}s`}
              >
                <span
                  class="grid h-12 w-12 shrink-0 place-items-center rounded-xl transition-transform duration-300 group-hover:scale-110"
                  style={`background:color-mix(in srgb, ${oInfo.color} 12%, white); color:${oInfo.color}`}
                >
                  <Icon name={oInfo.icono} class="h-6 w-6" />
                </span>
                <div class="min-w-0">
                  <h3 class="font-display text-sm font-bold text-ink-950 group-hover:text-brand-700">
                    {tax.sector(slug)}
                  </h3>
                  <p class="text-xs text-ink-500">{tpl(dict.comunes.nProductos, { n })}</p>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <CtaBand
    titulo={tpl(dict.segmento.ctaTitulo, { sector: sectorMinuscula })}
    texto={dict.segmento.ctaTexto}
    mensajeWhatsApp={copy.mensajeWhatsApp}
    lang={lang}
  />
</Base>
