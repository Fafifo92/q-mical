---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Wave from "../components/Wave.astro";
import SectionHead from "../components/SectionHead.astro";
import CtaBand from "../components/CtaBand.astro";
import { waLink } from "../data/site";
import { DEFAULT_LOCALE, type Locale } from "../i18n/config";
import { t } from "../i18n";

interface Props {
  lang?: Locale;
}
const { lang = DEFAULT_LOCALE } = Astro.props;
const dict = t(lang);

const iconosServicios = ["file-text", "beaker", "flask", "clipboard-check", "package", "truck"];
---

<Base
  title={dict.servicio.tituloMeta}
  description={dict.servicio.descripcionMeta}
  headerTheme="dark"
  og="servicio-tecnico"
  lang={lang}
>
  <!-- Héroe -->
  <section class="hero-mesh">
    <div class="container-site pt-32 pb-20 text-center md:pt-40 md:pb-28">
      <p class="reveal eyebrow text-accent-300">{dict.servicio.heroEyebrow}</p>
      <h1 class="reveal mx-auto mt-4 max-w-3xl font-display text-4xl font-bold text-white sm:text-5xl" style="--reveal-delay:.1s">
        {dict.servicio.heroTitulo1}<br />
        <span class="text-accent-300">{dict.servicio.heroTitulo2}</span>
      </h1>
      <p class="reveal mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink-200" style="--reveal-delay:.2s">
        {dict.servicio.heroTexto}
      </p>
    </div>
    <Wave />
  </section>

  <!-- Servicios -->
  <section class="container-site py-16 sm:py-24">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        dict.servicio.servicios.map((s, i) => (
          <article class="card reveal p-7 hover:shadow-card-hover" style={`--reveal-delay:${(i % 3) * 0.1}s`}>
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-brand-700 text-accent-300">
              <Icon name={iconosServicios[i]} class="h-6 w-6" />
            </span>
            <h2 class="mt-4 font-display text-lg font-bold">{s.titulo}</h2>
            <p class="mt-2 text-sm leading-relaxed text-ink-500">{s.texto}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Los 3 documentos -->
  <section class="border-y border-ink-100 bg-white py-16 sm:py-24">
    <div class="container-site">
      <SectionHead
        eyebrow={dict.servicio.docsEyebrow}
        titulo={dict.servicio.docsTitulo}
        descripcion={dict.servicio.docsTexto}
      />
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {
          dict.servicio.docs.map((doc, i) => (
            <article class="reveal relative overflow-hidden rounded-2xl border border-ink-100 bg-porcelain p-7" style={`--reveal-delay:${i * 0.12}s`}>
              <span class="font-display text-5xl font-bold text-ink-200">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="mt-2 font-display text-lg font-bold">{doc.t}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-500">{doc.d}</p>
            </article>
          ))
        }
      </div>
      <p class="reveal mx-auto mt-8 max-w-2xl text-center text-sm text-ink-500">
        {dict.servicio.docsPie}{" "}
        <a href={waLink(dict.servicio.waDocs)} target="_blank" rel="noopener" class="font-semibold text-brand-700 hover:underline">
          {dict.servicio.docsPieLink}
        </a>{" "}
        {dict.servicio.docsPieFin}
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-site max-w-3xl py-16 sm:py-24">
    <SectionHead eyebrow={dict.servicio.faqEyebrow} titulo={dict.servicio.faqTitulo} />
    <div class="mt-10 space-y-3">
      {
        dict.servicio.faqs.map((f, i) => (
          <details class="reveal group card overflow-hidden" style={`--reveal-delay:${i * 0.06}s`}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-display font-semibold text-ink-900 transition-colors group-open:text-brand-700 hover:text-brand-700 [&::-webkit-details-marker]:hidden">
              {f.q}
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-ink-200 transition-transform duration-300 group-open:rotate-180">
                <Icon name="chevron-down" class="h-4 w-4" />
              </span>
            </summary>
            <p class="px-5 pb-5 text-sm leading-relaxed text-ink-500">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <CtaBand titulo={dict.servicio.ctaTitulo} texto={dict.servicio.ctaTexto} lang={lang} />
</Base>
