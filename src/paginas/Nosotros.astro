---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Wave from "../components/Wave.astro";
import SectionHead from "../components/SectionHead.astro";
import CtaBand from "../components/CtaBand.astro";
import { SITE, waLink } from "../data/site";
import { getCatalogo } from "../lib/catalog";
import { DEFAULT_LOCALE, nombreEnFrase, rutaLocal, tpl, type Locale } from "../i18n/config";
import { t, taxonomia } from "../i18n";

interface Props {
  lang?: Locale;
}
const { lang = DEFAULT_LOCALE } = Astro.props;
const dict = t(lang);
const tax = taxonomia(lang);
const cat = getCatalogo(lang);

const iconosPrincipios = ["package", "users", "clock", "globe"];

const ciudades = [
  "Bogotá", "Medellín", "Cali", "Barranquilla", "Bucaramanga",
  "Cartagena", "Pereira", "Manizales", "Ibagué", "Villavicencio",
];
---

<Base
  title={dict.nosotros.tituloMeta}
  description={dict.nosotros.descripcionMeta}
  headerTheme="dark"
  og="nosotros"
  lang={lang}
>
  <!-- Héroe -->
  <section class="hero-mesh">
    <div class="container-site pt-32 pb-20 md:pt-40 md:pb-28">
      <p class="reveal eyebrow text-accent-300">{dict.nosotros.heroEyebrow}</p>
      <h1 class="reveal mt-4 max-w-4xl font-display text-4xl leading-[1.1] font-bold text-white sm:text-5xl" style="--reveal-delay:.1s">
        {dict.nosotros.heroTitulo}
      </h1>
    </div>
    <Wave />
  </section>

  <!-- Misión y visión -->
  <section class="container-site py-16 sm:py-24">
    <SectionHead eyebrow={dict.nosotros.propositoEyebrow} titulo={dict.nosotros.propositoTitulo} />
    <div class="mt-12 grid gap-5 lg:grid-cols-2">
      <article class="reveal relative overflow-hidden rounded-3xl bg-navy-700 p-8 text-white sm:p-10">
        <div class="pointer-events-none absolute -top-24 -right-24 h-64 w-64 rounded-full bg-brand-500/30 blur-3xl"></div>
        <span class="relative grid h-12 w-12 place-items-center rounded-xl bg-white/10 text-accent-300">
          <Icon name="target" class="h-6 w-6" />
        </span>
        <h3 class="relative mt-5 font-display text-2xl font-semibold text-white">{dict.nosotros.misionTitulo}</h3>
        <p class="relative mt-3 text-base leading-relaxed text-navy-100 sm:text-lg">{dict.nosotros.misionTexto}</p>
      </article>
      <article class="card reveal relative overflow-hidden p-8 sm:p-10" style="--reveal-delay:.12s">
        <div class="pointer-events-none absolute -top-24 -right-24 h-64 w-64 rounded-full bg-accent-300/30 blur-3xl"></div>
        <span class="relative grid h-12 w-12 place-items-center rounded-xl bg-brand-50 text-brand-600">
          <Icon name="eye" class="h-6 w-6" />
        </span>
        <h3 class="relative mt-5 font-display text-2xl font-semibold">{dict.nosotros.visionTitulo}</h3>
        <p class="relative mt-3 text-base leading-relaxed text-ink-600 sm:text-lg">{dict.nosotros.visionTexto}</p>
      </article>
    </div>

    <div class="reveal mt-8 flex flex-wrap items-center justify-center gap-3" style="--reveal-delay:.2s">
      <span class="font-display text-sm font-semibold tracking-wide text-ink-500 uppercase">{dict.nosotros.valoresTitulo}:</span>
      {
        dict.nosotros.valores.map((v) => (
          <span class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-white px-4 py-1.5 font-display text-sm font-semibold text-navy-700">
            <span class="h-1.5 w-1.5 rounded-full bg-accent-400" aria-hidden="true" />
            {v}
          </span>
        ))
      }
    </div>
  </section>

  <!-- Principios -->
  <section class="dots-pattern border-y border-ink-100 py-16 sm:py-24">
    <div class="container-site">
      <SectionHead
        eyebrow={dict.nosotros.principiosEyebrow}
        titulo={dict.nosotros.principiosTitulo}
        descripcion={dict.nosotros.principiosTexto}
      />
      <div class="mt-12 grid gap-5 sm:grid-cols-2">
        {
          dict.nosotros.principios.map((p, i) => (
            <article class="card reveal flex gap-5 p-7" style={`--reveal-delay:${(i % 2) * 0.1}s`}>
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-navy-700 text-accent-300">
                <Icon name={iconosPrincipios[i]} class="h-6 w-6" />
              </span>
              <div class="min-w-0">
                <h3 class="font-display text-lg font-semibold">{p.titulo}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-500">{p.texto}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Industrias + cobertura -->
  <section class="container-site grid gap-12 py-16 sm:py-24 lg:grid-cols-2">
    <!-- min-w-0: sin esto el <p class="truncate"> interno impone su ancho a toda la columna -->
    <div class="reveal min-w-0">
      <h2 class="font-display text-2xl font-semibold">{dict.nosotros.distribuimosTitulo}</h2>
      <ul class="mt-6 space-y-3">
        {
          tax.industrias.map((ind) => (
            <li>
              <a
                href={rutaLocal(lang, `/productos?industria=${ind.slug}`)}
                class="group flex items-center gap-4 rounded-xl border border-transparent p-2 transition-colors hover:border-ink-100 hover:bg-white"
              >
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-600">
                  <Icon name={ind.icono} class="h-5 w-5" />
                </span>
                <div class="min-w-0 flex-1">
                  <p class="font-display text-sm font-semibold text-ink-900">{ind.nombre}</p>
                  <p class="truncate text-xs text-ink-500">{ind.tagline}</p>
                </div>
                <Icon name="arrow-right" class="h-4 w-4 shrink-0 text-ink-300 transition-transform group-hover:translate-x-1 group-hover:text-brand-600" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="reveal min-w-0" style="--reveal-delay:.15s">
      <h2 class="font-display text-2xl font-semibold">{dict.nosotros.entregamosTitulo}</h2>
      <p class="mt-3 text-sm leading-relaxed text-ink-500">
        {tpl(dict.nosotros.entregamosTexto, { direccion: SITE.direccion })}
      </p>
      <div class="mt-6 flex flex-wrap gap-2">
        {
          ciudades.map((c) => (
            <span class="chip bg-white px-4 py-1.5 text-sm">
              <Icon name="map-pin" class="h-3.5 w-3.5 shrink-0 text-brand-600" />
              {c}
            </span>
          ))
        }
        <span class="chip border-dashed px-4 py-1.5 text-sm text-ink-500">{dict.nosotros.territorioNacional}</span>
      </div>

      <div class="card mt-8 flex items-start gap-4 p-6">
        <Icon name="shield-check" class="h-6 w-6 shrink-0 text-brand-600" />
        <p class="text-sm leading-relaxed text-ink-600 [&_strong]:text-ink-900" set:html={dict.nosotros.compromisoHtml} />
      </div>
    </div>
  </section>

  <!-- Nuestras líneas de producto -->
  <section class="dots-pattern border-t border-ink-100 py-16 sm:py-24">
    <div class="container-site">
      <SectionHead
        eyebrow={dict.nosotros.lineasEyebrow}
        titulo={dict.nosotros.lineasTitulo}
        descripcion={dict.nosotros.lineasTexto}
      />
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          tax.lineas.map((l, i) => {
            const n = cat.porLinea(l.slug).length;
            const href = n
              ? rutaLocal(lang, `/productos?linea=${l.slug}`)
              : waLink(tpl(dict.comunes.lineaWaMensaje, { linea: nombreEnFrase(l.nombre, lang) }));
            return (
              <a
                href={href}
                target={n ? undefined : "_blank"}
                rel={n ? undefined : "noopener"}
                class="card card-linea reveal group flex flex-col p-6"
                style={`--reveal-delay:${(i % 4) * 0.08}s`}
              >
                <span class="grid h-13 w-13 place-items-center rounded-2xl bg-brand-50 text-brand-600 transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-3">
                  <Icon name={l.icono} class="h-7 w-7" />
                </span>
                <h3 class="mt-4 font-display text-lg font-semibold">{l.nombre}</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-500">{l.tagline}</p>
                <p class="mt-4 flex items-center gap-1.5 text-sm font-semibold text-brand-700">
                  {n ? tpl(dict.comunes.nProductos, { n }) : dict.comunes.consultar}
                  <Icon name="arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
                </p>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <CtaBand titulo={dict.nosotros.ctaTitulo} texto={dict.nosotros.ctaTexto} lang={lang} />
</Base>
