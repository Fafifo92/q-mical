---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { waLink } from "../data/site";
import { DEFAULT_LOCALE, rutaLocal, type Locale } from "../i18n/config";
import { t } from "../i18n";

interface Props {
  lang?: Locale;
}
const { lang = DEFAULT_LOCALE } = Astro.props;
const dict = t(lang);
---

<Base title={dict.noEncontrada.tituloMeta} headerTheme="dark" lang={lang}>
  <section class="hero-mesh">
    <div class="container-site flex min-h-svh flex-col items-center justify-center py-32 text-center">
      <p class="reveal font-display text-7xl font-bold text-accent-300 sm:text-8xl">404</p>
      <h1 class="reveal mt-4 font-display text-3xl font-bold text-white sm:text-4xl" style="--reveal-delay:.1s">
        {dict.noEncontrada.titulo}
      </h1>
      <p class="reveal mt-4 max-w-md text-ink-200" style="--reveal-delay:.2s">
        {dict.noEncontrada.texto}
      </p>
      <div class="reveal mt-8 flex flex-wrap justify-center gap-3" style="--reveal-delay:.3s">
        <a href={rutaLocal(lang, "/")} class="btn-accent min-h-12 px-7">{dict.noEncontrada.botonInicio}</a>
        <a
          href={rutaLocal(lang, "/productos")}
          class="btn-ghost min-h-12 border-white/20 bg-white/5 px-7 text-white hover:border-accent-300 hover:text-accent-300"
        >
          {dict.noEncontrada.botonCatalogo}
        </a>
        <a href={waLink(dict.meta.waBase)} target="_blank" rel="noopener" class="btn-whatsapp min-h-12 px-7">
          <Icon name="whatsapp" class="h-5 w-5" />
          {dict.noEncontrada.botonWa}
        </a>
      </div>
    </div>
  </section>
</Base>
