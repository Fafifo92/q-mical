---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Wave from "../components/Wave.astro";
import SectionHead from "../components/SectionHead.astro";
import ProductCard from "../components/ProductCard.astro";
import CtaBand from "../components/CtaBand.astro";
import { SITE, waLink } from "../data/site";
import { SECTORES_INFO } from "../data/taxonomy";
import { STATS, getCatalogo } from "../lib/catalog";
import { DEFAULT_LOCALE, rutaLocal, tpl, type Locale } from "../i18n/config";
import { t, taxonomia } from "../i18n";

interface Props {
  lang?: Locale;
}
const { lang = DEFAULT_LOCALE } = Astro.props;
const dict = t(lang);
const tax = taxonomia(lang);
const cat = getCatalogo(lang);

const productosDestacados = cat.destacados(8);

const stats = [
  { valor: STATS.productos, sufijo: "+", label: dict.home.statProductos },
  { valor: STATS.lineas, sufijo: "", label: dict.home.statLineas },
  { valor: STATS.especialidades, sufijo: "", label: dict.home.statEspecialidades },
  { valor: STATS.sectores, sufijo: "", label: dict.home.statSectores },
];

const iconosPasos = ["message-circle", "file-text", "credit-card", "truck"];
const iconosValores = ["package", "file-text", "flask", "clipboard-check", "truck", "beaker"];
---

<Base title={SITE.nombre} headerTheme="dark" lang={lang}>
  <!-- ═══════════════ HERO ═══════════════ -->
  <section class="hero-mesh relative">
    <div class="container-site grid min-h-svh items-center gap-12 pt-28 pb-16 lg:grid-cols-[1.2fr_1fr] lg:pt-32">
      <div>
        <p class="reveal eyebrow text-accent-300" style="--reveal-delay:.05s">
          {dict.home.heroEyebrow}
        </p>
        <h1
          class="reveal mt-4 font-display text-4xl leading-[1.05] font-bold text-white sm:text-5xl lg:text-6xl"
          style="--reveal-delay:.15s"
        >
          {dict.home.heroTitulo1}<br />
          <span class="text-accent-300">{dict.home.heroTitulo2}</span>
        </h1>
        <p class="reveal mt-6 max-w-xl text-lg leading-relaxed text-ink-200" style="--reveal-delay:.25s">
          {dict.home.heroTexto}
        </p>

        <!-- Buscador rápido -->
        <form
          class="reveal mt-8 flex max-w-xl overflow-hidden rounded-full border border-white/15 bg-white/10 backdrop-blur transition-colors focus-within:border-accent-400"
          action={rutaLocal(lang, "/productos")}
          method="get"
          style="--reveal-delay:.35s"
        >
          <label class="sr-only" for="hero-q">{dict.home.buscarAria}</label>
          <input
            id="hero-q"
            type="search"
            name="q"
            placeholder={dict.home.buscarPlaceholder}
            class="w-full bg-transparent px-6 py-4 text-sm text-white placeholder:text-ink-300 focus:outline-none"
            autocomplete="off"
          />
          <button type="submit" class="btn-accent m-1.5 min-h-11 shrink-0 px-5 text-sm" aria-label={dict.home.buscarBoton}>
            <Icon name="search" class="h-4 w-4" />
            <span class="hidden sm:inline">{dict.home.buscarBoton}</span>
          </button>
        </form>

        <div class="reveal mt-6 flex flex-wrap gap-3" style="--reveal-delay:.45s">
          <a
            href={rutaLocal(lang, "/productos")}
            class="btn-ghost min-h-11 border-white/20 bg-white/5 px-6 text-sm text-white hover:border-accent-300 hover:text-accent-300"
          >
            {dict.home.botonCatalogo}
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
          <a href={waLink(dict.meta.waBase)} target="_blank" rel="noopener" class="btn-whatsapp min-h-11 px-6 text-sm">
            <Icon name="whatsapp" class="h-4 w-4" />
            {dict.home.botonWa}
          </a>
        </div>
      </div>

      <!-- Panel de líneas flotante -->
      <div class="reveal hidden lg:block" style="--reveal-delay:.4s">
        <div class="grid grid-cols-2 gap-4">
          {
            tax.lineas.map((l, i) => (
              <a
                href={rutaLocal(lang, `/productos?linea=${l.slug}`)}
                class="group rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur transition-all duration-300 hover:-translate-y-1 hover:border-white/25 hover:bg-white/10"
                style={`animation: float ${8 + (i % 4)}s ease-in-out ${i * 0.7}s infinite`}
              >
                <span
                  class="grid h-11 w-11 place-items-center rounded-xl transition-transform duration-300 group-hover:scale-110"
                  style={`background:color-mix(in srgb, ${l.color} 25%, transparent); color:${l.color}`}
                >
                  <Icon name={l.icono} class="h-6 w-6" />
                </span>
                <p class="mt-3 font-display text-sm font-semibold text-white">{l.corto}</p>
                <p class="mt-1 text-xs text-ink-300">{tpl(dict.comunes.nProductos, { n: cat.porLinea(l.slug).length })}</p>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <Wave />
  </section>

  <!-- ═══════════════ STATS ═══════════════ -->
  <!-- relative z-10: el héroe es `relative` y se pintaría encima de estas cifras -->
  <section class="relative z-10 bg-porcelain pt-6 pb-2">
    <div class="container-site">
      <dl class="grid grid-cols-2 gap-x-4 gap-y-8 lg:grid-cols-4">
        {
          stats.map((s, i) => (
            <div class="reveal text-center" style={`--reveal-delay:${i * 0.1}s`}>
              <dd class="font-display text-4xl font-bold text-brand-700 sm:text-5xl">
                <span class="countup" data-target={s.valor}>0</span>{s.sufijo}
              </dd>
              <dt class="mx-auto mt-1 max-w-[16ch] text-sm leading-snug text-ink-500">{s.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ═══════════════ MARQUEE SECTORES ═══════════════ -->
  <section class="mt-14 overflow-hidden border-y border-ink-100 bg-white py-4">
    <div class="flex w-max animate-marquee gap-10 whitespace-nowrap">
      {
        [0, 1].map((copia) =>
          Object.entries(tax.sectores).map(([slug, s]) => (
            <a
              href={rutaLocal(lang, `/sectores/${slug}`)}
              class="flex items-center gap-10 text-sm font-medium tracking-wide text-ink-500 uppercase transition-colors hover:text-brand-700"
              aria-hidden={copia === 1 ? "true" : undefined}
              tabindex={copia === 1 ? -1 : undefined}
            >
              {s}
              <span class="h-1.5 w-1.5 rounded-full bg-accent-400" aria-hidden="true" />
            </a>
          ))
        )
      }
    </div>
  </section>

  <!-- ═══════════════ LÍNEAS ═══════════════ -->
  <section class="container-site py-20 sm:py-28">
    <SectionHead
      eyebrow={dict.home.lineasEyebrow}
      titulo={dict.home.lineasTitulo}
      descripcion={dict.home.lineasTexto}
    />
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        tax.lineas.map((l, i) => (
          <a
            href={rutaLocal(lang, `/productos?linea=${l.slug}`)}
            class="card card-linea reveal group flex flex-col p-6"
            style={`--linea-color:${l.color};--reveal-delay:${(i % 4) * 0.08}s`}
          >
            <span
              class="grid h-13 w-13 place-items-center rounded-2xl transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-3"
              style={`background:color-mix(in srgb, ${l.color} 12%, white); color:${l.color}`}
            >
              <Icon name={l.icono} class="h-7 w-7" />
            </span>
            <h3 class="mt-4 font-display text-lg font-bold">{l.nombre}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-500">{l.tagline}</p>
            <p class="mt-4 flex items-center gap-1.5 text-sm font-semibold" style={`color:color-mix(in srgb, ${l.color} 60%, black)`}>
              {tpl(dict.comunes.nProductos, { n: cat.porLinea(l.slug).length })}
              <Icon name="arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ═══════════════ SEGMENTOS DE MERCADO ═══════════════ -->
  <section class="border-y border-ink-100 bg-white py-20 sm:py-28">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHead
          align="left"
          eyebrow={dict.home.segmentosEyebrow}
          titulo={dict.home.segmentosTitulo}
          descripcion={dict.home.segmentosTexto}
        />
        <a href={rutaLocal(lang, "/sectores")} class="btn-ghost reveal min-h-11 px-6 text-sm">
          {dict.home.segmentosBoton}
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {
          Object.entries(tax.sectores).map(([slug, label], i) => {
            const info = SECTORES_INFO[slug]!;
            return (
              <a
                href={rutaLocal(lang, `/sectores/${slug}`)}
                class="card card-linea reveal group flex items-center gap-3.5 p-4"
                style={`--linea-color:${info.color};--reveal-delay:${(i % 4) * 0.06}s`}
              >
                <span
                  class="grid h-10 w-10 shrink-0 place-items-center rounded-lg transition-transform duration-300 group-hover:scale-110"
                  style={`background:color-mix(in srgb, ${info.color} 12%, white); color:${info.color}`}
                >
                  <Icon name={info.icono} class="h-5 w-5" />
                </span>
                <div class="min-w-0">
                  <h3 class="truncate font-display text-sm font-bold text-ink-950 group-hover:text-brand-700">{label}</h3>
                  <p class="text-xs text-ink-500">{tpl(dict.comunes.nProductos, { n: cat.porSector(slug).length })}</p>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════ BANNER PRESENTACIONES ═══════════════ -->
  <section class="container-site pb-20 sm:pb-28 pt-20 sm:pt-28">
    <div class="reveal card overflow-hidden lg:grid lg:grid-cols-[1.1fr_1fr]">
      <div
        class="relative bg-brand-900 p-8 text-white sm:p-12"
        style="background-image: radial-gradient(rgb(255 255 255 / 0.08) 1px, transparent 1px); background-size: 22px 22px;"
      >
        <p class="eyebrow text-accent-300">{dict.home.bannerEyebrow}</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-white">
          {dict.home.bannerTitulo}
        </h2>
        <p class="mt-4 leading-relaxed text-brand-100 [&_strong]:text-accent-300" set:html={dict.home.bannerTextoHtml} />
        <a href={rutaLocal(lang, "/servicio-tecnico")} class="btn-accent mt-6 min-h-11 px-6 text-sm">
          {dict.home.bannerBoton}
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
      <ul class="grid content-center gap-4 p-8 sm:p-12">
        {
          dict.home.bannerBullets.map((b) => (
            <li class="flex gap-4">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-brand-50 text-brand-700">
                <Icon name="check" class="h-5 w-5" />
              </span>
              <div>
                <h3 class="font-display font-semibold text-ink-950">{b.titulo}</h3>
                <p class="mt-1 text-sm leading-relaxed text-ink-500">{b.texto}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ═══════════════ CÓMO TRABAJAMOS ═══════════════ -->
  <section class="border-y border-ink-100 bg-white py-20 sm:py-28">
    <div class="container-site">
      <SectionHead
        eyebrow={dict.home.procesoEyebrow}
        titulo={dict.home.procesoTitulo}
        descripcion={dict.home.procesoTexto}
      />
      <ol class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          dict.home.pasos.map((p, i) => (
            <li class="reveal relative text-center" style={`--reveal-delay:${i * 0.12}s`}>
              {i < dict.home.pasos.length - 1 && (
                <span class="absolute top-8 left-[calc(50%+2.5rem)] hidden h-px w-[calc(100%-5rem)] bg-gradient-to-r from-brand-300 to-transparent lg:block" aria-hidden="true" />
              )}
              <span class="relative mx-auto grid h-16 w-16 place-items-center rounded-2xl bg-brand-50 text-brand-700">
                <Icon name={iconosPasos[i]} class="h-7 w-7" />
                <span class="absolute -top-2 -right-2 grid h-6 w-6 place-items-center rounded-full bg-accent-400 font-display text-xs font-bold text-ink-950">
                  {i + 1}
                </span>
              </span>
              <h3 class="mt-5 font-display text-lg font-bold">{p.titulo}</h3>
              <p class="mx-auto mt-2 max-w-xs text-sm leading-relaxed text-ink-500">{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ═══════════════ DESTACADOS ═══════════════ -->
  {
    productosDestacados.length > 0 && (
      <section class="container-site py-20 sm:py-28">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <SectionHead
            align="left"
            eyebrow={dict.home.destacadosEyebrow}
            titulo={dict.home.destacadosTitulo}
            descripcion={dict.home.destacadosTexto}
          />
          <a href={rutaLocal(lang, "/productos")} class="btn-ghost reveal min-h-11 px-6 text-sm">
            {dict.home.destacadosBoton}
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </div>
        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {productosDestacados.map((p, i) => (
            <ProductCard producto={p} reveal revealDelay={(i % 4) * 0.08} lang={lang} />
          ))}
        </div>
      </section>
    )
  }

  <!-- ═══════════════ PROPUESTA DE VALOR ═══════════════ -->
  <section class="dots-pattern border-y border-ink-100 py-20 sm:py-28">
    <div class="container-site">
      <SectionHead
        eyebrow={dict.home.valoresEyebrow}
        titulo={dict.home.valoresTitulo}
        descripcion={dict.home.valoresTexto}
      />
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          dict.home.valores.map((v, i) => (
            <article class="card reveal p-7 hover:shadow-card-hover" style={`--reveal-delay:${(i % 3) * 0.1}s`}>
              <span class="grid h-12 w-12 place-items-center rounded-xl bg-brand-700 text-accent-300">
                <Icon name={iconosValores[i]} class="h-6 w-6" />
              </span>
              <h3 class="mt-4 font-display text-lg font-bold">{v.titulo}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-500">{v.texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>

<script>
  /* Contador animado de las estadísticas del héroe. */
  function initCountup() {
    const els = Array.from(document.querySelectorAll<HTMLElement>(".countup"));
    if (!els.length) return;

    const menosMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const pintar = (el: HTMLElement) => (el.textContent = el.dataset.target ?? "0");

    // Sin animación (o sin observer): el número final se pinta directo.
    if (menosMovimiento || !("IntersectionObserver" in window)) {
      els.forEach(pintar);
      return;
    }

    const animar = (el: HTMLElement) => {
      const target = Number(el.dataset.target ?? 0);
      const dur = 1400;
      const t0 = performance.now();
      const tick = (t: number) => {
        const p = Math.min((t - t0) / dur, 1);
        el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
      // Salvavidas: si rAF no corre (pestaña en segundo plano), el número
      // igual queda escrito — nunca se muestra un 0 permanente.
      setTimeout(() => pintar(el), dur + 400);
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          io.unobserve(e.target);
          animar(e.target as HTMLElement);
        }
      },
      { threshold: 0.6 }
    );
    els.forEach((el) => io.observe(el));
  }
  document.addEventListener("astro:page-load", initCountup);
  initCountup();
</script>
