---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import SectionHead from "../components/SectionHead.astro";
import ProductCard from "../components/ProductCard.astro";
import CtaBand from "../components/CtaBand.astro";
import CarruselNoticias from "../components/CarruselNoticias.astro";
import ArteMarca from "../components/ArteMarca.astro";
import { SITE, waLink } from "../data/site";
import { fotoIndustria } from "../lib/imagenes";
import { STATS, getCatalogo } from "../lib/catalog";
import { DEFAULT_LOCALE, nombreEnFrase, rutaLocal, tpl, type Locale } from "../i18n/config";
import { t, taxonomia } from "../i18n";

interface Props {
  lang?: Locale;
}
const { lang = DEFAULT_LOCALE } = Astro.props;
const dict = t(lang);
const tax = taxonomia(lang);
const cat = getCatalogo(lang);

const productosDestacados = cat.destacados(8);

const stats = [
  { valor: STATS.productos, sufijo: "+", label: dict.home.statProductos },
  { valor: STATS.lineas, sufijo: "", label: dict.home.statLineas },
  { valor: STATS.industrias, sufijo: "", label: dict.home.statIndustrias },
  { valor: 1, sufijo: " kg", label: dict.home.statMinimo },
];

const iconosPasos = ["message-circle", "file-text", "credit-card", "truck"];
const iconosValores = ["package", "file-text", "flask", "clipboard-check", "truck", "beaker"];
---

<Base title={SITE.nombre} headerTheme="dark" lang={lang}>
  <h1 class="sr-only">{SITE.nombre} — {dict.meta.slogan}</h1>

  <!-- ═══════════════ NOTICIAS ROTATIVAS ═══════════════ -->
  <CarruselNoticias lang={lang} />

  <!-- ═══════════════ CIFRAS ═══════════════ -->
  <!-- relative z-10: el carrusel es `relative` y se pintaría encima de estas cifras -->
  <section class="relative z-10 bg-porcelain pt-6 pb-2">
    <div class="container-site">
      <dl class="grid grid-cols-2 gap-x-4 gap-y-8 lg:grid-cols-4">
        {
          stats.map((s, i) => (
            <div class="reveal text-center" style={`--reveal-delay:${i * 0.1}s`}>
              <dd class="font-display text-4xl font-bold text-brand-600 sm:text-5xl">
                <span class="countup" data-target={s.valor}>0</span>{s.sufijo}
              </dd>
              <dt class="mx-auto mt-1 max-w-[18ch] text-sm leading-snug text-ink-500">{s.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ═══════════════ MARQUEE INDUSTRIAS ═══════════════ -->
  <section class="mt-14 overflow-hidden border-y border-ink-100 bg-white py-4">
    <div class="flex w-max animate-marquee gap-10 whitespace-nowrap">
      {
        // Dos copias exactas: la animación desplaza -50% y el bucle queda sin salto
        [0, 1].map((copia) =>
          tax.industrias.map((ind) => (
            <a
              href={rutaLocal(lang, `/productos?industria=${ind.slug}`)}
              class="flex items-center gap-10 font-display text-sm font-semibold tracking-wide text-ink-500 uppercase transition-colors hover:text-brand-600"
              aria-hidden={copia === 1 ? "true" : undefined}
              tabindex={copia === 1 ? -1 : undefined}
            >
              {ind.nombre}
              <span class="h-1.5 w-1.5 rounded-full bg-accent-400" aria-hidden="true" />
            </a>
          ))
        )
      }
    </div>
  </section>

  <!-- ═══════════════ INDUSTRIAS (con imagen) ═══════════════ -->
  <section class="container-site py-20 sm:py-28">
    <SectionHead
      eyebrow={dict.home.industriasEyebrow}
      titulo={dict.home.industriasTitulo}
      descripcion={dict.home.industriasTexto}
    />
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        tax.industrias.map((ind, i) => {
          const foto = fotoIndustria(ind.slug);
          return (
            <a
              href={rutaLocal(lang, `/productos?industria=${ind.slug}`)}
              class="card card-linea reveal group flex flex-col overflow-hidden"
              style={`--reveal-delay:${(i % 4) * 0.08}s`}
            >
              <div class="relative aspect-[16/10] overflow-hidden bg-navy-700">
                {foto ? (
                  <>
                    <img
                      src={foto}
                      alt=""
                      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-navy-900/55 via-transparent to-transparent" />
                    <span class="absolute bottom-3 left-3 grid h-10 w-10 place-items-center rounded-xl bg-white/95 text-brand-600 shadow-md transition-transform duration-300 group-hover:scale-110">
                      <Icon name={ind.icono} class="h-5 w-5" />
                    </span>
                  </>
                ) : (
                  <ArteMarca icono={ind.icono} variante={i} />
                )}
              </div>
              <div class="flex flex-1 flex-col p-5">
                <h3 class="font-display text-lg font-semibold">{ind.nombre}</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-500">{ind.tagline}</p>
                <p class="mt-4 flex items-center gap-1.5 text-sm font-semibold text-brand-700">
                  {tpl(dict.comunes.nProductos, { n: cat.porIndustria(ind.slug).length })}
                  <Icon name="arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
                </p>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  <!-- ═══════════════ ENTRA POR LÍNEA DE PRODUCTO ═══════════════ -->
  <section class="border-y border-ink-100 bg-white py-20 sm:py-28">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHead
          align="left"
          eyebrow={dict.home.lineasEyebrow}
          titulo={dict.home.lineasTitulo}
          descripcion={dict.home.lineasTexto}
        />
        <a href={rutaLocal(lang, "/productos")} class="btn-ghost reveal min-h-11 px-6 text-sm">
          {dict.home.lineasBoton}
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
      <div class="mt-10 grid grid-cols-1 gap-4 xs:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {
          tax.lineas.map((l, i) => {
            const n = cat.porLinea(l.slug).length;
            // Una línea sin productos publicados se cotiza directo con un asesor
            const href = n
              ? rutaLocal(lang, `/productos?linea=${l.slug}`)
              : waLink(tpl(dict.comunes.lineaWaMensaje, { linea: nombreEnFrase(l.nombre, lang) }));
            return (
              <a
                href={href}
                target={n ? undefined : "_blank"}
                rel={n ? undefined : "noopener"}
                class="card card-linea reveal group flex items-center gap-3.5 p-4"
                style={`--reveal-delay:${(i % 4) * 0.06}s`}
              >
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-600 transition-transform duration-300 group-hover:scale-110">
                  <Icon name={l.icono} class="h-5 w-5" />
                </span>
                <div class="min-w-0">
                  <h3 class="font-display text-sm font-semibold text-ink-950 group-hover:text-brand-700">{l.nombre}</h3>
                  <p class="text-xs text-ink-500">
                    {n ? tpl(dict.comunes.nProductos, { n }) : dict.comunes.consultar}
                  </p>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- ═══════════════ BANNER PRESENTACIONES ═══════════════ -->
  <section class="container-site pb-20 sm:pb-28 pt-20 sm:pt-28">
    <div class="reveal card overflow-hidden lg:grid lg:grid-cols-[1.1fr_1fr]">
      <div
        class="relative bg-navy-700 p-8 text-white sm:p-12"
        style="background-image: radial-gradient(rgb(255 255 255 / 0.08) 1px, transparent 1px); background-size: 22px 22px;"
      >
        <p class="eyebrow text-accent-300">{dict.home.bannerEyebrow}</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-white">
          {dict.home.bannerTitulo}
        </h2>
        <p class="mt-4 leading-relaxed text-navy-100 [&_strong]:text-accent-300" set:html={dict.home.bannerTextoHtml} />
        <a href={`${rutaLocal(lang, "/contacto")}#preguntas-frecuentes`} class="btn-accent mt-6 min-h-11 px-6 text-sm">
          {dict.home.bannerBoton}
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
      <ul class="grid content-center gap-4 p-8 sm:p-12">
        {
          dict.home.bannerBullets.map((b) => (
            <li class="flex gap-4">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-brand-50 text-brand-600">
                <Icon name="check" class="h-5 w-5" />
              </span>
              <div>
                <h3 class="font-display font-semibold text-ink-950">{b.titulo}</h3>
                <p class="mt-1 text-sm leading-relaxed text-ink-500">{b.texto}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ═══════════════ CÓMO TRABAJAMOS ═══════════════ -->
  <section class="border-y border-ink-100 bg-white py-20 sm:py-28">
    <div class="container-site">
      <SectionHead
        eyebrow={dict.home.procesoEyebrow}
        titulo={dict.home.procesoTitulo}
        descripcion={dict.home.procesoTexto}
      />
      <ol class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          dict.home.pasos.map((p, i) => (
            <li class="reveal relative text-center" style={`--reveal-delay:${i * 0.12}s`}>
              {i < dict.home.pasos.length - 1 && (
                <span class="absolute top-8 left-[calc(50%+2.5rem)] hidden h-px w-[calc(100%-5rem)] bg-gradient-to-r from-brand-300 to-transparent lg:block" aria-hidden="true" />
              )}
              <span class="relative mx-auto grid h-16 w-16 place-items-center rounded-2xl bg-brand-50 text-brand-600">
                <Icon name={iconosPasos[i]} class="h-7 w-7" />
                <span class="absolute -top-2 -right-2 grid h-6 w-6 place-items-center rounded-full bg-accent-400 font-display text-xs font-bold text-navy-700">
                  {i + 1}
                </span>
              </span>
              <h3 class="mt-5 font-display text-lg font-semibold">{p.titulo}</h3>
              <p class="mx-auto mt-2 max-w-xs text-sm leading-relaxed text-ink-500">{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ═══════════════ DESTACADOS ═══════════════ -->
  {
    productosDestacados.length > 0 && (
      <section class="container-site py-20 sm:py-28">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <SectionHead
            align="left"
            eyebrow={dict.home.destacadosEyebrow}
            titulo={dict.home.destacadosTitulo}
            descripcion={dict.home.destacadosTexto}
          />
          <a href={rutaLocal(lang, "/productos")} class="btn-ghost reveal min-h-11 px-6 text-sm">
            {dict.home.destacadosBoton}
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </div>
        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {productosDestacados.map((p, i) => (
            <ProductCard producto={p} reveal revealDelay={(i % 4) * 0.08} lang={lang} />
          ))}
        </div>
      </section>
    )
  }

  <!-- ═══════════════ PROPUESTA DE VALOR ═══════════════ -->
  <section class="dots-pattern border-y border-ink-100 py-20 sm:py-28">
    <div class="container-site">
      <SectionHead
        eyebrow={dict.home.valoresEyebrow}
        titulo={dict.home.valoresTitulo}
        descripcion={dict.home.valoresTexto}
      />
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          dict.home.valores.map((v, i) => (
            <article class="card reveal p-7 hover:shadow-card-hover" style={`--reveal-delay:${(i % 3) * 0.1}s`}>
              <span class="grid h-12 w-12 place-items-center rounded-xl bg-navy-700 text-accent-300">
                <Icon name={iconosValores[i]} class="h-6 w-6" />
              </span>
              <h3 class="mt-4 font-display text-lg font-semibold">{v.titulo}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-500">{v.texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>

<script>
  /* Contador animado de las cifras. */
  function initCountup() {
    const els = Array.from(document.querySelectorAll<HTMLElement>(".countup"));
    if (!els.length) return;

    const menosMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const pintar = (el: HTMLElement) => (el.textContent = el.dataset.target ?? "0");

    // Sin animación (o sin observer): el número final se pinta directo.
    if (menosMovimiento || !("IntersectionObserver" in window)) {
      els.forEach(pintar);
      return;
    }

    const animar = (el: HTMLElement) => {
      const target = Number(el.dataset.target ?? 0);
      const dur = 1400;
      const t0 = performance.now();
      const tick = (t: number) => {
        const p = Math.min((t - t0) / dur, 1);
        el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
      // Salvavidas: si rAF no corre (pestaña en segundo plano), el número
      // igual queda escrito — nunca se muestra un 0 permanente.
      setTimeout(() => pintar(el), dur + 400);
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          io.unobserve(e.target);
          animar(e.target as HTMLElement);
        }
      },
      { threshold: 0.6 }
    );
    els.forEach((el) => io.observe(el));
  }
  document.addEventListener("astro:page-load", initCountup);
  initCountup();
</script>
