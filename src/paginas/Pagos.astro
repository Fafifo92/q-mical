---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import CtaBand from "../components/CtaBand.astro";
import { SITE, waLink } from "../data/site";
import { DEFAULT_LOCALE, tpl, type Locale } from "../i18n/config";
import { t } from "../i18n";

interface Props {
  lang?: Locale;
}
const { lang = DEFAULT_LOCALE } = Astro.props;
const dict = t(lang);

const iconosPasos = ["message-circle", "file-text", "credit-card", "truck"];
---

<Base title={dict.pagos.tituloMeta} description={dict.pagos.descripcionMeta} og="pagos" lang={lang}>
  <section class="border-b border-ink-100 bg-white pt-28 pb-12 md:pt-36">
    <div class="container-site max-w-3xl text-center">
      <span class="reveal mx-auto grid h-16 w-16 place-items-center rounded-2xl bg-ink-950 font-display text-lg font-bold text-accent-300">
        PSE
      </span>
      <h1 class="reveal mt-6 text-3xl font-bold tracking-tight sm:text-4xl" style="--reveal-delay:.1s">
        {dict.pagos.titulo}
      </h1>
      <p class="reveal mx-auto mt-4 max-w-xl leading-relaxed text-ink-500" style="--reveal-delay:.18s">
        {dict.pagos.introTexto}
      </p>
      <div class="reveal mt-8 flex flex-wrap justify-center gap-3" style="--reveal-delay:.26s">
        <a href={SITE.pseUrl} target="_blank" rel="noopener" class="btn-primary min-h-13 px-8 text-base">
          <Icon name="credit-card" class="h-5 w-5 shrink-0" />
          {dict.pagos.botonPortal}
          <Icon name="arrow-up-right" class="h-4 w-4 shrink-0" />
        </a>
        <a href={waLink(dict.pagos.waLink)} target="_blank" rel="noopener" class="btn-whatsapp min-h-13 px-8 text-base">
          <Icon name="whatsapp" class="h-5 w-5 shrink-0" />
          {dict.pagos.botonLink}
        </a>
      </div>
    </div>
  </section>

  <!-- Pasos -->
  <section class="container-site py-16 sm:py-24">
    <ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        dict.pagos.pasos.map((p, i) => (
          <li class="reveal card relative p-7" style={`--reveal-delay:${i * 0.1}s`}>
            <span class="absolute -top-3 left-7 grid h-7 w-7 place-items-center rounded-full bg-accent-400 font-display text-xs font-bold text-ink-950">
              {i + 1}
            </span>
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-brand-50 text-brand-700">
              <Icon name={iconosPasos[i]} class="h-6 w-6" />
            </span>
            <h2 class="mt-4 font-display text-base font-bold">{p.titulo}</h2>
            <p class="mt-2 text-sm leading-relaxed text-ink-500">{p.texto}</p>
          </li>
        ))
      }
    </ol>

    <!-- Seguridad -->
    <div class="reveal mx-auto mt-14 flex max-w-2xl gap-4 rounded-2xl border border-amber-200 bg-amber-50 p-6" role="note">
      <Icon name="shield-check" class="h-6 w-6 shrink-0 text-amber-600" />
      <div class="min-w-0 text-sm leading-relaxed text-amber-900">
        <p class="font-semibold">{dict.pagos.seguridadTitulo}</p>
        <ul class="mt-2 list-disc space-y-1 pl-4">
          {dict.pagos.seguridadBullets.map((b) => <li set:html={tpl(b, { email: SITE.email })} />)}
        </ul>
      </div>
    </div>
  </section>

  <CtaBand titulo={dict.pagos.ctaTitulo} texto={dict.pagos.ctaTexto} lang={lang} />
</Base>
