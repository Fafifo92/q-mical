---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import ProductCard from "../components/ProductCard.astro";
import { waLink } from "../data/site";
import { getCatalogo, type Producto } from "../lib/catalog";
import { DEFAULT_LOCALE, rutaLocal, tpl, type Locale } from "../i18n/config";
import { t, taxonomia } from "../i18n";

interface Props {
  producto: Producto;
  lang?: Locale;
}
const { producto: p, lang = DEFAULT_LOCALE } = Astro.props;
const dict = t(lang);
const tax = taxonomia(lang);
const cat = getCatalogo(lang);

// Línea principal = la primera del producto (define ícono, migas e imagen OG)
const linea = tax.linea(p.lineas[0])!;
const similares = cat.relacionados(p, 4);

const mensajeWa = tpl(dict.producto.waMensaje, { nombre: p.nombre, id: p.id });
const iconosDocs = ["file-text", "shield-check", "clipboard-check"];

// La nota de pago lleva el enlace incrustado: se parte la plantilla por {link}
const [pagoAntes, pagoDespues] = dict.producto.pagoTextoHtml.split("{link}");
---

<Base title={p.nombre} description={p.descripcion} headerTheme="light" og={`linea-${linea.slug}`} lang={lang}>
  <!-- Encabezado del producto -->
  <section class="relative overflow-hidden border-b border-ink-100 bg-white pt-28 pb-12 md:pt-36">
    <div class="pointer-events-none absolute -top-32 -right-32 h-96 w-96 rounded-full bg-brand-500 opacity-[0.12] blur-3xl">
    </div>

    <div class="container-site relative">
      <!-- Migas -->
      <nav class="reveal flex flex-wrap items-center gap-2 text-xs text-ink-500" aria-label="Breadcrumb">
        <a href={rutaLocal(lang, "/")} class="hover:text-brand-700">{dict.producto.migaInicio}</a>
        <span aria-hidden="true">/</span>
        <a href={rutaLocal(lang, "/productos")} class="hover:text-brand-700">{dict.producto.migaPortafolio}</a>
        <span aria-hidden="true">/</span>
        <a href={rutaLocal(lang, `/productos?linea=${linea.slug}`)} class="hover:text-brand-700">{linea.nombre}</a>
        <span aria-hidden="true">/</span>
        <span class="font-medium text-ink-600">{p.nombre}</span>
      </nav>

      <div class="mt-8 flex flex-col gap-8 md:flex-row md:items-start">
        <span
          class="reveal grid h-20 w-20 shrink-0 place-items-center rounded-3xl bg-brand-50 text-brand-600 md:h-24 md:w-24"
          style="--reveal-delay:.1s"
        >
          <Icon name={linea.icono} class="h-10 w-10 md:h-12 md:w-12" />
        </span>

        <div class="min-w-0">
          <div class="reveal flex flex-wrap items-center gap-2" style="--reveal-delay:.12s">
            {
              p.lineas.map((slug) => (
                <a
                  href={rutaLocal(lang, `/productos?linea=${slug}`)}
                  class="chip border-brand-200 text-brand-700 transition-colors hover:bg-brand-50"
                >
                  {tax.linea(slug)?.corto ?? slug}
                </a>
              ))
            }
            {
              p.destacado && (
                <span class="chip border-accent-300 bg-accent-100 text-ink-800">
                  <Icon name="sparkles" class="h-3 w-3" />
                  {dict.comunes.destacado}
                </span>
              )
            }
          </div>

          <h1 class="reveal mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl" style="--reveal-delay:.18s">
            {p.nombre}
          </h1>

          {
            (p.inci || p.sinonimos.length > 0) && (
              <dl class="reveal mt-3 space-y-1 text-sm text-ink-500" style="--reveal-delay:.24s">
                {p.inci && (
                  <div class="flex gap-2">
                    <dt class="font-semibold text-ink-700">{dict.producto.inci}</dt>
                    <dd class="italic">{p.inci}</dd>
                  </div>
                )}
                {p.sinonimos.length > 0 && (
                  <div class="flex flex-wrap gap-2">
                    <dt class="font-semibold text-ink-700">{dict.producto.sinonimos}</dt>
                    <dd>{p.sinonimos.join(" · ")}</dd>
                  </div>
                )}
              </dl>
            )
          }

          <p class="reveal mt-5 max-w-2xl text-base leading-relaxed text-ink-600 sm:text-lg" style="--reveal-delay:.3s">
            {p.descripcion}
          </p>

          <div class="reveal mt-6 flex flex-wrap gap-3" style="--reveal-delay:.36s">
            <a href={waLink(mensajeWa)} target="_blank" rel="noopener" class="btn-whatsapp min-h-12 px-6 text-sm">
              <Icon name="whatsapp" class="h-5 w-5" />
              {dict.producto.botonWa}
            </a>
            <a href={rutaLocal(lang, `/cotizacion?producto=${encodeURIComponent(p.nombre)}`)} class="btn-primary min-h-12 px-6 text-sm">
              {dict.producto.botonCotizacion}
              <Icon name="arrow-right" class="h-4 w-4" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cuerpo -->
  <section class="container-site grid gap-10 py-12 lg:grid-cols-[1fr_380px]">
    <div class="min-w-0 space-y-10">
      <!-- Funciones -->
      <div class="reveal">
        <h2 class="font-display text-xl font-bold">{dict.producto.funciones}</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {
            p.funciones.map((f) => (
              <span class="rounded-full bg-brand-50 px-4 py-1.5 text-sm font-medium text-brand-800">{f}</span>
            ))
          }
        </div>
      </div>

      <!-- Aplicaciones -->
      <div class="reveal">
        <h2 class="font-display text-xl font-semibold">{dict.producto.aplicaciones}</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {
            p.aplicaciones.map((a) => (
              <li class="flex items-start gap-3 rounded-xl border border-ink-100 bg-white p-4 text-sm text-ink-700">
                <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand-100 text-brand-700">
                  <Icon name="check" class="h-3 w-3" strokeWidth={3} />
                </span>
                {a}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Líneas de producto e industrias -->
      <div class="reveal grid gap-6 sm:grid-cols-2">
        <div>
          <h2 class="font-display text-xl font-semibold">{dict.producto.lineas}</h2>
          <div class="mt-4 flex flex-wrap gap-2">
            {
              p.lineas.map((slug) => (
                <a href={rutaLocal(lang, `/productos?linea=${slug}`)} class="chip transition-colors hover:border-brand-400 hover:text-brand-700">
                  {tax.linea(slug)?.nombre ?? slug}
                </a>
              ))
            }
          </div>
        </div>
        <div>
          <h2 class="font-display text-xl font-semibold">{dict.producto.industrias}</h2>
          <div class="mt-4 flex flex-wrap gap-2">
            {
              p.industrias.map((slug) => (
                <a href={rutaLocal(lang, `/productos?industria=${slug}`)} class="chip transition-colors hover:border-brand-400 hover:text-brand-700">
                  {tax.industria(slug)?.nombre ?? slug}
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Disclaimer de presentación -->
      <aside class="reveal flex gap-4 rounded-2xl border border-amber-200 bg-amber-50 p-5" role="note">
        <Icon name="info" class="h-5 w-5 shrink-0 text-amber-600" />
        <p class="text-sm leading-relaxed text-amber-900" set:html={dict.producto.disclaimerHtml} />
      </aside>
    </div>

    <!-- Panel lateral -->
    <aside class="space-y-5 lg:sticky lg:top-28 lg:self-start">
      <!-- Presentación -->
      <div class="card reveal p-6">
        <h2 class="flex items-center gap-2 font-display text-base font-bold">
          <Icon name="package" class="h-5 w-5 text-brand-600" />
          {dict.producto.presentacion}
        </h2>
        <ul class="mt-3 space-y-2">
          {
            p.formas_referenciales.map((f) => (
              <li class="rounded-xl bg-porcelain px-4 py-2.5 text-sm text-ink-700">{f}</li>
            ))
          }
        </ul>
        <dl class="mt-4 grid grid-cols-2 gap-3 border-t border-ink-100 pt-4 text-sm">
          <div>
            <dt class="text-xs text-ink-500 uppercase">{dict.producto.origen}</dt>
            <dd class="mt-0.5 font-medium text-ink-800">{tax.origen(p.origen)}</dd>
          </div>
          <div>
            <dt class="text-xs text-ink-500 uppercase">{dict.producto.referencia}</dt>
            <dd class="mt-0.5 font-mono text-xs break-all text-ink-600">{p.id}</dd>
          </div>
        </dl>
        <p class="mt-4 text-xs leading-relaxed text-ink-500">
          {dict.producto.notaEmpaque}
        </p>
      </div>

      <!-- Documentación -->
      <div class="card reveal p-6" style="--reveal-delay:.1s">
        <h2 class="flex items-center gap-2 font-display text-base font-bold">
          <Icon name="file-text" class="h-5 w-5 text-brand-600" />
          {dict.producto.documentacion}
        </h2>
        <ul class="mt-3 space-y-3">
          {
            dict.producto.docs.map((d, i) => (
              <li class="flex items-start gap-3">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-700">
                  <Icon name={iconosDocs[i]} class="h-4 w-4" />
                </span>
                <div>
                  <p class="text-sm font-semibold text-ink-800">{d.nombre}</p>
                  <p class="text-xs text-ink-500">{d.detalle}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <a
          href={waLink(tpl(dict.producto.waDocs, { nombre: p.nombre, id: p.id }))}
          target="_blank"
          rel="noopener"
          class="btn-ghost mt-5 min-h-11 w-full px-4 text-sm"
        >
          <Icon name="whatsapp" class="h-4 w-4 text-[#25d366]" />
          {dict.producto.botonDocs}
        </a>
      </div>

      <!-- Pago -->
      <div class="reveal flex items-center gap-4 rounded-2xl bg-navy-700 p-5 text-white" style="--reveal-delay:.2s">
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-white/10 text-accent-300">
          <Icon name="credit-card" class="h-5 w-5" />
        </span>
        <p class="text-sm text-navy-100">
          <Fragment set:html={pagoAntes} />
          <a href={rutaLocal(lang, "/pagos")} class="font-semibold text-accent-300 hover:underline">{dict.producto.pagoLink}</a>
          <Fragment set:html={pagoDespues} />
        </p>
      </div>
    </aside>
  </section>

  <!-- Relacionados -->
  {
    similares.length > 0 && (
      <section class="border-t border-ink-100 bg-white py-16">
        <div class="container-site">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <h2 class="reveal font-display text-2xl font-semibold">{dict.producto.relacionados}</h2>
            <a href={rutaLocal(lang, `/productos?linea=${linea.slug}`)} class="reveal text-sm font-semibold text-brand-700 hover:underline">
              {tpl(dict.producto.verLinea, { linea: linea.nombre })}
            </a>
          </div>
          <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {similares.map((s, i) => (
              <ProductCard producto={s} reveal revealDelay={i * 0.08} lang={lang} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>
