---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import SectionHead from "../components/SectionHead.astro";
import CtaBand from "../components/CtaBand.astro";
import { SITE, waLink, mapaEmbed, mapaLink } from "../data/site";
import { DEFAULT_LOCALE, type Locale } from "../i18n/config";
import { t } from "../i18n";

interface Props {
  lang?: Locale;
}
const { lang = DEFAULT_LOCALE } = Astro.props;
const dict = t(lang);
const c = dict.contacto;

// Cadenas que el script necesita para armar el mensaje
const i18nJs = {
  faltantes: c.jsFaltantes,
  correoInvalido: c.jsCorreoInvalido,
  campos: {
    nombre: c.jsCampoNombre,
    empresa: c.jsCampoEmpresa,
    contacto: c.jsCampoContacto,
    necesidad: c.jsCampoNecesidad,
  },
  msg: {
    titulo: c.msgTitulo,
    nombre: c.msgNombre,
    empresa: c.msgEmpresa,
    telefono: c.msgTelefono,
    correo: c.msgCorreo,
    necesidad: c.msgNecesidad,
  },
  asunto: c.mailtoAsunto,
};
---

<Base title={c.tituloMeta} description={c.descripcionMeta} og="contacto" lang={lang}>
  <!-- Encabezado -->
  <section class="border-b border-ink-100 bg-white pt-28 pb-10 md:pt-36">
    <div class="container-site">
      <p class="eyebrow reveal">{c.eyebrow}</p>
      <h1 class="reveal mt-2 max-w-3xl text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl" style="--reveal-delay:.08s">
        {c.titulo}
      </h1>
      <p class="reveal mt-4 max-w-2xl leading-relaxed text-ink-500" style="--reveal-delay:.16s">{c.intro}</p>
    </div>
  </section>

  <!-- Formulario (izquierda) + mapa (derecha) -->
  <section class="container-site grid items-start gap-8 py-12 lg:grid-cols-[1.05fr_1fr] lg:py-16">
    <form
      id="form-contacto"
      class="card reveal space-y-5 p-6 sm:p-8"
      novalidate
      data-wa={SITE.whatsapp}
      data-correo={SITE.email}
    >
      <h2 class="font-display text-xl font-semibold">{c.formTitulo}</h2>

      <div class="grid gap-5 sm:grid-cols-2">
        <label class="block">
          <span class="text-sm font-medium text-ink-700">
            {c.nombre} <span class="text-red-600" aria-hidden="true">*</span>
          </span>
          <input type="text" name="nombre" required autocomplete="name" class="input-q" placeholder={c.nombrePlaceholder} />
        </label>
        <label class="block">
          <span class="text-sm font-medium text-ink-700">
            {c.empresa} <span class="text-red-600" aria-hidden="true">*</span>
          </span>
          <input type="text" name="empresa" required autocomplete="organization" class="input-q" placeholder={c.empresaPlaceholder} />
        </label>
        <label class="block">
          <span class="text-sm font-medium text-ink-700">{c.telefono}</span>
          <input type="tel" name="telefono" autocomplete="tel" class="input-q" placeholder="+57 300 000 0000" />
        </label>
        <label class="block">
          <span class="text-sm font-medium text-ink-700">{c.correo}</span>
          <input type="email" name="correo" autocomplete="email" class="input-q" placeholder={c.correoPlaceholder} />
        </label>
      </div>

      <label class="block">
        <span class="text-sm font-medium text-ink-700">
          {c.necesidad} <span class="text-red-600" aria-hidden="true">*</span>
        </span>
        <textarea name="necesidad" rows="5" required class="input-q resize-y" placeholder={c.necesidadPlaceholder}></textarea>
      </label>

      <p id="error-contacto" class="hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert"></p>

      <div class="flex flex-col gap-3 sm:flex-row">
        <button type="submit" class="btn-whatsapp min-h-13 flex-1 px-6 text-base">
          <Icon name="whatsapp" class="h-5 w-5 shrink-0" />
          {c.botonEnviar}
        </button>
        <button type="button" id="btn-contacto-correo" class="btn-ghost min-h-13 px-6 text-base">
          <Icon name="mail" class="h-4 w-4 shrink-0" />
          {c.botonCorreo}
        </button>
      </div>
      <p class="text-xs leading-relaxed text-ink-500">{c.notaEnvio}</p>
    </form>

    <div class="reveal space-y-5" style="--reveal-delay:.12s">
      <div class="card overflow-hidden">
        <div class="flex items-center justify-between gap-3 border-b border-ink-100 px-6 py-4">
          <h2 class="flex items-center gap-2 font-display text-lg font-semibold">
            <Icon name="map-pin" class="h-5 w-5 text-brand-600" />
            {c.mapaTitulo}
          </h2>
          <a href={mapaLink} target="_blank" rel="noopener" class="btn-ghost min-h-10 px-4 text-sm">
            <Icon name="navigation" class="h-4 w-4" />
            {c.comoLlegar}
          </a>
        </div>
        <iframe
          src={mapaEmbed}
          title={c.mapaIframe}
          class="block h-80 w-full border-0 lg:h-[23rem]"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>

      <ul class="card divide-y divide-ink-100 text-sm">
        <li class="flex items-start gap-4 px-6 py-4">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-600">
            <Icon name="map-pin" class="h-5 w-5" />
          </span>
          <div>
            <p class="text-xs font-semibold tracking-wide text-ink-500 uppercase">{c.direccion}</p>
            <p class="mt-0.5 font-medium text-ink-900">{SITE.direccion}</p>
            <p class="text-ink-500">{SITE.ciudad}</p>
          </div>
        </li>
        <li class="flex items-start gap-4 px-6 py-4">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-600">
            <Icon name="phone" class="h-5 w-5" />
          </span>
          <div>
            <p class="text-xs font-semibold tracking-wide text-ink-500 uppercase">{c.telefonoLabel}</p>
            <p class="mt-0.5 font-medium text-ink-900">{SITE.telefono}</p>
          </div>
        </li>
        <li class="flex items-start gap-4 px-6 py-4">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-600">
            <Icon name="mail" class="h-5 w-5" />
          </span>
          <div class="min-w-0">
            <p class="text-xs font-semibold tracking-wide text-ink-500 uppercase">{c.correoLabel}</p>
            <a href={`mailto:${SITE.email}`} class="mt-0.5 block font-medium break-all text-ink-900 hover:text-brand-700">{SITE.email}</a>
          </div>
        </li>
        <li class="px-6 py-4">
          <a href={waLink(dict.meta.waBase)} target="_blank" rel="noopener" class="btn-whatsapp min-h-11 w-full px-5 text-sm">
            <Icon name="whatsapp" class="h-4 w-4" />
            {c.botonWa}
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- Preguntas frecuentes -->
  <section id="preguntas-frecuentes" class="scroll-mt-24 border-t border-ink-100 bg-white py-16 sm:py-24">
    <div class="container-site max-w-3xl">
      <SectionHead eyebrow={c.faqEyebrow} titulo={c.faqTitulo} />
      <div class="mt-10 space-y-3">
        {
          c.faqs.map((f, i) => (
            <details class="reveal group card overflow-hidden" style={`--reveal-delay:${i * 0.06}s`} open={i === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-display font-semibold text-ink-900 transition-colors group-open:text-brand-700 hover:text-brand-700 [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-ink-200 transition-transform duration-300 group-open:rotate-180">
                  <Icon name="chevron-down" class="h-4 w-4" />
                </span>
              </summary>
              <p class="px-5 pb-5 text-sm leading-relaxed text-ink-600">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand titulo={c.ctaTitulo} texto={c.ctaTexto} lang={lang} />

  <script type="application/json" id="i18n-contacto" set:html={JSON.stringify(i18nJs)} />
</Base>

<style>
  textarea.input-q {
    height: auto;
    padding-block: 0.75rem;
  }
</style>

<script>
  function initContacto() {
    const form = document.getElementById("form-contacto") as HTMLFormElement | null;
    if (!form || form.dataset.init === "1") return;
    form.dataset.init = "1";

    const I18N = JSON.parse(document.getElementById("i18n-contacto")?.textContent ?? "{}");
    const $error = document.getElementById("error-contacto")!;

    /** Valida y arma el mensaje; si falta algo muestra el error y devuelve null. */
    function construirMensaje(): string | null {
      const datos = new FormData(form!);
      const v = (k: string) => String(datos.get(k) ?? "").trim();

      const faltantes: string[] = [];
      if (!v("nombre")) faltantes.push(I18N.campos.nombre);
      if (!v("empresa")) faltantes.push(I18N.campos.empresa);
      if (!v("telefono") && !v("correo")) faltantes.push(I18N.campos.contacto);
      if (!v("necesidad")) faltantes.push(I18N.campos.necesidad);

      let problema = "";
      if (faltantes.length) problema = I18N.faltantes.replace("{campos}", faltantes.join(", "));
      else if (v("correo") && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v("correo"))) problema = I18N.correoInvalido;

      if (problema) {
        $error.textContent = problema;
        $error.classList.remove("hidden");
        $error.scrollIntoView({ behavior: "smooth", block: "center" });
        return null;
      }
      $error.classList.add("hidden");

      const m = I18N.msg;
      return [
        `*${m.titulo}*`,
        "",
        `*${m.nombre}:* ${v("nombre")}`,
        `*${m.empresa}:* ${v("empresa")}`,
        v("telefono") ? `*${m.telefono}:* ${v("telefono")}` : null,
        v("correo") ? `*${m.correo}:* ${v("correo")}` : null,
        "",
        `*${m.necesidad}:*`,
        v("necesidad"),
      ]
        .filter((l) => l !== null)
        .join("\n");
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const msg = construirMensaje();
      if (!msg) return;
      window.open(`https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(msg)}`, "_blank", "noopener");
    });

    document.getElementById("btn-contacto-correo")?.addEventListener("click", () => {
      const msg = construirMensaje();
      if (!msg) return;
      location.href = `mailto:${form.dataset.correo}?subject=${encodeURIComponent(I18N.asunto)}&body=${encodeURIComponent(msg.replace(/\*/g, ""))}`;
    });
  }

  document.addEventListener("astro:page-load", initContacto);
  initContacto();
</script>
