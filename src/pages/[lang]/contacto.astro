---
import Contacto from "../../paginas/Contacto.astro";
import { LOCALES_PREFIJADOS, type Locale } from "../../i18n/config";

export function getStaticPaths() {
  return LOCALES_PREFIJADOS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
---

<Contacto lang={lang} />
