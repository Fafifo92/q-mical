---
import Portafolio from "../../../paginas/Portafolio.astro";
import { LOCALES_PREFIJADOS, type Locale } from "../../../i18n/config";

export function getStaticPaths() {
  return LOCALES_PREFIJADOS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
---

<Portafolio lang={lang} />
