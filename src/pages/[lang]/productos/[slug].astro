---
import Producto from "../../../paginas/Producto.astro";
import { getCatalogo } from "../../../lib/catalog";
import { LOCALES_PREFIJADOS, type Locale } from "../../../i18n/config";

/** 6 idiomas × 227 productos: cada ficha en su idioma, mismo slug. */
export function getStaticPaths() {
  return LOCALES_PREFIJADOS.flatMap((lang) =>
    getCatalogo(lang).productos.map((p) => ({
      params: { lang, slug: p.id },
      props: { producto: p },
    }))
  );
}

const lang = Astro.params.lang as Locale;
const { producto } = Astro.props;
---

<Producto producto={producto} lang={lang} />
