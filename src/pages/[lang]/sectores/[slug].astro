---
import Segmento from "../../../paginas/Segmento.astro";
import { sectoresCopy } from "../../../i18n";
import { LOCALES_PREFIJADOS, type Locale } from "../../../i18n/config";

export function getStaticPaths() {
  return LOCALES_PREFIJADOS.flatMap((lang) =>
    sectoresCopy(lang).map((copy) => ({ params: { lang, slug: copy.slug }, props: { copy } }))
  );
}

const lang = Astro.params.lang as Locale;
const { copy } = Astro.props;
---

<Segmento copy={copy} lang={lang} />
