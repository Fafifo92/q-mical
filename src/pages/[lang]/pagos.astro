---
import Pagos from "../../paginas/Pagos.astro";
import { SITE } from "../../data/site";
import { LOCALES_PREFIJADOS, type Locale } from "../../i18n/config";

export function getStaticPaths() {
  return LOCALES_PREFIJADOS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;

// Página oculta: mientras SITE.pagosActivo sea false, se redirige al inicio del idioma.
if (!SITE.pagosActivo) return Astro.redirect(`/${lang}/`);
---

<Pagos lang={lang} />
