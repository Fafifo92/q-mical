---
/**
 * Portada de los idiomas con prefijo: /en/, /fr/, /pt/, /de/, /ru/, /zh/
 * (el español vive en la raíz, sin prefijo).
 */
import Inicio from "../../paginas/Inicio.astro";
import { LOCALES_PREFIJADOS, type Locale } from "../../i18n/config";

export function getStaticPaths() {
  return LOCALES_PREFIJADOS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
---

<Inicio lang={lang} />
