---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { SITE, waLink, telHref } from "../data/site";
import { DEFAULT_LOCALE, rutaLocal, tpl, type Locale } from "../i18n/config";
import { t, taxonomia } from "../i18n";

interface Props {
  lang?: Locale;
}
const { lang = DEFAULT_LOCALE } = Astro.props;
const dict = t(lang);
const tax = taxonomia(lang);

const year = new Date().getFullYear();
const redes = [
  { nombre: "instagram", url: SITE.redes.instagram },
  { nombre: "linkedin", url: SITE.redes.linkedin },
  { nombre: "facebook", url: SITE.redes.facebook },
  { nombre: "youtube", url: SITE.redes.youtube },
].filter((r) => r.url);
---

<footer class="relative overflow-hidden bg-navy-800 text-ink-200">
  <div class="pointer-events-none absolute -top-40 right-0 h-96 w-96 rounded-full bg-brand-500/20 blur-3xl"></div>

  <div class="container-site relative grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-[1.3fr_.8fr_1.1fr_.9fr_1.45fr] lg:gap-10">
    <!-- Marca -->
    <div>
      <a href={rutaLocal(lang, "/")} class="inline-flex" aria-label={dict.nav.inicioAria}>
        <Logo tone="dark" />
      </a>
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-navy-100">
        {dict.meta.descripcion}
      </p>
      {
        redes.length > 0 && (
          <div class="mt-5 flex gap-2">
            {redes.map((r) => (
              <a
                href={r.url}
                target="_blank"
                rel="noopener"
                aria-label={r.nombre}
                class="grid h-9 w-9 place-items-center rounded-full border border-white/15 text-navy-100 transition-colors hover:border-accent-400 hover:text-accent-300"
              >
                <Icon name={r.nombre} class="h-4 w-4" />
              </a>
            ))}
          </div>
        )
      }
    </div>

    <!-- Industrias -->
    <nav aria-label={dict.footer.industrias}>
      <h3 class="font-display text-sm font-semibold tracking-wider text-white uppercase">{dict.footer.industrias}</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          tax.industrias.map((i) => (
            <li>
              <a href={rutaLocal(lang, `/productos?industria=${i.slug}`)} class="text-navy-100 transition-colors hover:text-accent-300">
                {i.corto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Líneas de producto -->
    <nav aria-label={dict.footer.lineas}>
      <h3 class="font-display text-sm font-semibold tracking-wider text-white uppercase">{dict.footer.lineas}</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          tax.lineas.slice(0, 7).map((l) => (
            <li>
              <a href={rutaLocal(lang, `/productos?linea=${l.slug}`)} class="text-navy-100 transition-colors hover:text-accent-300">
                {l.nombre}
              </a>
            </li>
          ))
        }
        <li>
          <a href={rutaLocal(lang, "/productos")} class="font-medium text-accent-400 transition-colors hover:text-accent-300">
            {dict.footer.todoPortafolio}
          </a>
        </li>
      </ul>
    </nav>

    <!-- Empresa -->
    <nav aria-label={dict.footer.empresa}>
      <h3 class="font-display text-sm font-semibold tracking-wider text-white uppercase">{dict.footer.empresa}</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a href={rutaLocal(lang, "/productos")} class="text-navy-100 hover:text-accent-300">{dict.footer.linkPortafolio}</a></li>
        <li><a href={rutaLocal(lang, "/nosotros")} class="text-navy-100 hover:text-accent-300">{dict.footer.linkNosotros}</a></li>
        <li><a href={rutaLocal(lang, "/contacto")} class="text-navy-100 hover:text-accent-300">{dict.footer.linkContacto}</a></li>
        <li><a href={rutaLocal(lang, "/cotizacion")} class="text-navy-100 hover:text-accent-300">{dict.footer.linkCotizacion}</a></li>
        {SITE.pagosActivo && <li><a href={rutaLocal(lang, "/pagos")} class="text-navy-100 hover:text-accent-300">{dict.footer.linkPagos}</a></li>}
      </ul>
    </nav>

    <!-- Contacto -->
    <div>
      <h3 class="font-display text-sm font-semibold tracking-wider text-white uppercase">{dict.footer.contacto}</h3>
      <ul class="mt-4 space-y-3 text-sm">
        <li class="flex items-start gap-2.5">
          <Icon name="map-pin" class="mt-0.5 h-4 w-4 shrink-0 text-accent-400" />
          <a href={rutaLocal(lang, "/contacto")} class="hover:text-accent-300">{SITE.direccion}<br />{SITE.ciudad}</a>
        </li>
        <li class="flex items-start gap-2.5">
          <Icon name="phone" class="mt-0.5 h-4 w-4 shrink-0 text-accent-400" />
          <span class="flex flex-col gap-1">
            <a href={telHref(SITE.telefono)} class="hover:text-accent-300">{SITE.telefono}</a>
            <a href={telHref(SITE.telefono2)} class="hover:text-accent-300">{SITE.telefono2}</a>
          </span>
        </li>
        <li class="flex items-center gap-2.5">
          <Icon name="mail" class="h-4 w-4 shrink-0 text-accent-400" />
          <a href={`mailto:${SITE.email}`} class="min-w-0 [overflow-wrap:anywhere] hover:text-accent-300">{SITE.email}</a>
        </li>
      </ul>
      <a
        href={waLink(dict.meta.waBase)}
        target="_blank"
        rel="noopener"
        class="btn-whatsapp mt-5 w-full max-w-xs px-5 py-3 text-sm"
      >
        <Icon name="whatsapp" class="h-4 w-4 shrink-0" />
        {dict.footer.botonWhatsApp}
      </a>
    </div>
  </div>

  <div class="relative border-t border-white/10">
    <div class="container-site flex flex-col items-center justify-between gap-3 py-6 text-xs text-navy-200 sm:flex-row">
      {/* Sin el punto final de "S.A.S.": la plantilla ya pone su propio punto */}
      <p>{tpl(dict.footer.derechos, { year, empresa: SITE.razonSocial.replace(/\.$/, "") })}</p>
      <p class="max-w-md text-center sm:text-right">
        {dict.footer.disclaimer}
      </p>
    </div>
    <p class="container-site pb-5 text-center text-xs text-navy-300">
      {dict.footer.credito}{" "}
      <a
        href="https://emeteatech.com"
        target="_blank"
        rel="noopener"
        class="font-semibold text-navy-200 transition-colors hover:text-accent-300"
      >EMETEA Tech</a>
    </p>
  </div>
</footer>
