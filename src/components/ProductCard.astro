---
import Icon from "./Icon.astro";
import type { Producto } from "../lib/catalog";
import { normalizar } from "../lib/fuzzy";
import { DEFAULT_LOCALE, rutaLocal, type Locale } from "../i18n/config";
import { t, taxonomia } from "../i18n";

/**
 * Tarjeta de producto. Los data-* alimentan el filtrado de /productos:
 * - data-buscar: nombre + INCI + sinónimos → se tokeniza para la búsqueda difusa.
 * - data-desc:   descripción → solo búsqueda por subcadena (sin difusa, evita ruido).
 * - data-lineas / data-industrias: slugs para las dos facetas del portafolio.
 */
interface Props {
  producto: Producto;
  reveal?: boolean;
  revealDelay?: number;
  lang?: Locale;
}
const { producto: p, reveal = false, revealDelay = 0, lang = DEFAULT_LOCALE } = Astro.props;
const dict = t(lang);
const tax = taxonomia(lang);
const linea = tax.linea(p.lineas[0]);
const industria = tax.industria(p.industrias[0]);

const textoBusqueda = normalizar([p.nombre, p.inci ?? "", ...p.sinonimos].join(" "));
const textoDescripcion = normalizar(p.descripcion);
---

<a
  href={rutaLocal(lang, `/productos/${p.id}`)}
  class:list={["producto-card card card-linea group flex flex-col p-6", reveal && "reveal"]}
  style={reveal ? `--reveal-delay:${revealDelay}s` : undefined}
  data-nombre={p.nombre}
  data-buscar={textoBusqueda}
  data-desc={textoDescripcion}
  data-lineas={p.lineas.join(" ")}
  data-industrias={p.industrias.join(" ")}
  data-destacado={p.destacado ? "1" : "0"}
>
  <div class="flex items-start justify-between gap-2">
    <span
      class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-600 transition-transform duration-300 group-hover:scale-110"
    >
      <Icon name={linea?.icono ?? "flask"} class="h-6 w-6" />
    </span>
    {
      p.destacado && (
        <span class="chip shrink-0 border-accent-300 bg-accent-100 text-ink-800">
          <Icon name="sparkles" class="h-3 w-3" />
          {dict.comunes.destacado}
        </span>
      )
    }
  </div>

  <h3 class="mt-4 font-display text-base leading-snug font-semibold text-ink-950 group-hover:text-brand-700">
    {p.nombre}
  </h3>
  {p.inci && <p class="mt-0.5 truncate text-xs text-ink-500 italic">{p.inci}</p>}

  <p class="mt-2.5 line-clamp-2 text-sm leading-relaxed text-ink-500">{p.descripcion}</p>

  <div class="mt-4 flex flex-1 items-end justify-between gap-2">
    <div class="flex min-w-0 flex-wrap gap-1.5">
      <span class="chip max-w-full truncate border-brand-200 text-brand-700">
        {linea?.corto ?? p.lineas[0]}
      </span>
      {industria && <span class="chip hidden max-w-full truncate sm:inline-flex">{industria.corto}</span>}
    </div>
    <span
      class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-ink-200 text-ink-400 transition-all duration-300 group-hover:border-brand-600 group-hover:bg-brand-600 group-hover:text-white"
    >
      <Icon name="arrow-right" class="h-4 w-4" />
    </span>
  </div>
</a>
