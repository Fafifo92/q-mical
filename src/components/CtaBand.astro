---
import Icon from "./Icon.astro";
import { waLink } from "../data/site";
import { DEFAULT_LOCALE, rutaLocal, type Locale } from "../i18n/config";
import { t } from "../i18n";

/** Banda de llamado a la acción (fondo oscuro) reutilizable al pie de páginas. */
interface Props {
  titulo?: string;
  texto?: string;
  mensajeWhatsApp?: string;
  lang?: Locale;
}
const { lang = DEFAULT_LOCALE } = Astro.props;
const dict = t(lang);
const {
  titulo = dict.ctaBand.titulo,
  texto = dict.ctaBand.texto,
  mensajeWhatsApp = dict.meta.waBase,
} = Astro.props;
---

<section class="container-site py-16 sm:py-24">
  <div class="hero-mesh reveal relative overflow-hidden rounded-3xl px-6 py-14 text-center sm:px-12 sm:py-20">
    <p class="eyebrow text-accent-300">{dict.ctaBand.eyebrow}</p>
    <h2 class="mx-auto mt-3 max-w-2xl font-display text-3xl font-bold text-white sm:text-4xl">
      {titulo}
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-ink-200">
      {texto}
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href={waLink(mensajeWhatsApp)} target="_blank" rel="noopener" class="btn-whatsapp min-h-12 px-7">
        <Icon name="whatsapp" class="h-5 w-5" />
        {dict.ctaBand.botonWa}
      </a>
      <a href={rutaLocal(lang, "/cotizacion")} class="btn-accent min-h-12 px-7">
        {dict.ctaBand.botonCotizar}
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>
