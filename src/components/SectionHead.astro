---
/** Encabezado de sección: eyebrow + título + descripción, con revelado. */
interface Props {
  eyebrow?: string;
  titulo: string;
  descripcion?: string;
  align?: "center" | "left";
  class?: string;
}
const { eyebrow, titulo, descripcion, align = "center", class: className = "" } = Astro.props;
---

<div
  class:list={[
    "reveal max-w-2xl",
    align === "center" ? "mx-auto text-center" : "text-left",
    className,
  ]}
>
  {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
  <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{titulo}</h2>
  {descripcion && <p class="mt-4 text-base leading-relaxed text-ink-500 sm:text-lg">{descripcion}</p>}
</div>
