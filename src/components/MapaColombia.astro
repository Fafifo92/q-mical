---
/**
 * Mapa de Colombia con las ciudades de entrega. Al pasar el mouse (o tocar /
 * enfocar con teclado) cada punzón muestra el nombre de la ciudad. El mapa es
 * SVG inline y los punzones son HTML encima, así el tooltip usa la tipografía
 * y los colores de la marca. Ciudades: src/data/cobertura.ts
 */
import { MAPA } from "../data/mapaColombia";
import { CIUDADES, posicion } from "../data/cobertura";

interface Props {
  /** Descripción para lectores de pantalla. */
  etiqueta: string;
}
const { etiqueta } = Astro.props;

const pines = CIUDADES.map((c, i) => ({ ...c, ...posicion(c.lat, c.lon), i }));
---

<div class="mapa relative mx-auto w-full max-w-[27rem]" style={`aspect-ratio:${MAPA.ancho}/${MAPA.alto}`}>
  <svg
    viewBox={`0 0 ${MAPA.ancho} ${MAPA.alto}`}
    class="mapa-svg absolute inset-0 h-full w-full"
    role="img"
    aria-label={etiqueta}
  >
    <defs>
      <linearGradient id="mapa-tierra" x1="0" y1="0" x2="0.6" y2="1">
        <stop offset="0" style="stop-color: var(--color-brand-100)"></stop>
        <stop offset="1" style="stop-color: var(--color-brand-200)"></stop>
      </linearGradient>
    </defs>
    {
      MAPA.deptos.map((d) => (
        <path d={d.d} class="depto" fill="url(#mapa-tierra)" />
      ))
    }
  </svg>

  <ul class="absolute inset-0 m-0 list-none p-0">
    {
      pines.map((c) => (
        <li
          class:list={["pin", c.sede && "pin-sede"]}
          style={`left:${c.x.toFixed(2)}%;top:${c.y.toFixed(2)}%;--i:${c.i}`}
        >
          <span class="pin-punto" tabindex="0" role="img" aria-label={c.nombre}>
            <span class="pin-onda" aria-hidden="true"></span>
          </span>
          <span class="pin-tip" aria-hidden="true">{c.nombre}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* Silueta: el contorno exterior sale de un drop-shadow sin desenfoque (solo
     mira el alfa del conjunto, así que no dibuja las líneas internas) */
  .mapa-svg {
    filter: drop-shadow(0 0 0.7px var(--color-brand-600)) drop-shadow(0 18px 24px rgb(11 59 94 / 0.16));
    overflow: visible;
  }
  .depto {
    stroke: white;
    stroke-width: 1.1;
    stroke-linejoin: round;
    transition: filter 0.3s ease;
  }

  .pin {
    position: absolute;
    width: 0;
    height: 0;
  }
  .pin-punto {
    position: absolute;
    left: -6px;
    top: -6px;
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 9999px;
    background: var(--color-brand-600);
    border: 2px solid white;
    box-shadow: 0 2px 6px rgb(11 59 94 / 0.4);
    cursor: pointer;
    outline: none;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }
  .pin-sede .pin-punto {
    left: -8px;
    top: -8px;
    width: 16px;
    height: 16px;
    background: var(--color-navy-700);
    border-color: var(--color-accent-400);
  }
  .pin-onda {
    position: absolute;
    inset: -2px;
    border-radius: 9999px;
    border: 2px solid var(--color-brand-400);
    opacity: 0;
    animation: pin-onda 2.8s ease-out infinite;
    animation-delay: calc(var(--i) * 0.28s);
    pointer-events: none;
  }
  .pin-sede .pin-onda {
    border-color: var(--color-accent-500);
  }
  @keyframes pin-onda {
    0% { transform: scale(1); opacity: 0.75; }
    70%, 100% { transform: scale(3.2); opacity: 0; }
  }

  .pin-tip {
    position: absolute;
    bottom: 14px;
    left: 0;
    translate: -50% 4px;
    padding: 0.3rem 0.65rem;
    border-radius: 9999px;
    background: var(--color-navy-700);
    color: white;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    box-shadow: 0 8px 20px -8px rgb(11 59 94 / 0.55);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease, translate 0.18s ease;
    z-index: 5;
  }
  .pin-tip::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    translate: -50% -1px;
    border: 5px solid transparent;
    border-top-color: var(--color-navy-700);
  }
  .pin:hover,
  .pin:focus-within {
    z-index: 10;
  }
  .pin:hover .pin-punto,
  .pin-punto:focus-visible {
    transform: scale(1.35);
    background: var(--color-accent-500);
  }
  .pin-punto:focus-visible {
    box-shadow: 0 0 0 3px var(--color-brand-300), 0 2px 6px rgb(11 59 94 / 0.4);
  }
  .pin:hover .pin-tip,
  .pin:focus-within .pin-tip {
    opacity: 1;
    translate: -50% 0;
  }

  /* Entrada: los punzones aparecen escalonados cuando el mapa se revela */
  :global(.js .reveal:not(.in)) .pin-punto {
    transform: scale(0);
  }
  :global(.js .reveal.in) .pin-punto {
    transition-delay: calc(var(--i) * 0.07s + 0.25s), 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .pin-onda {
      animation: none;
    }
    .pin-punto,
    .pin-tip {
      transition: none;
    }
  }
</style>
